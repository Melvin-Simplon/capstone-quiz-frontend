echo "\033[1;34m🔍 Running lint on staged files...\033[0m"
npm run lint
LINT_STATUS=$?
if [ $LINT_STATUS -ne 0 ]; then
  echo "\033[1;31m❌ Lint failed. Commit aborted.\033[0m"
  exit 1
else
  echo "\033[1;32m✅ Lint passed!\033[0m"
fi

echo "\033[1;34m🧪 Running tests...\033[0m"
npm run test
TEST_STATUS=$?
if [ $TEST_STATUS -ne 0 ]; then
  echo "\033[1;31m❌ Tests failed. Commit aborted.\033[0m"
  exit 1
else
  echo "\033[1;32m✅ All tests passed!\033[0m"
fi
