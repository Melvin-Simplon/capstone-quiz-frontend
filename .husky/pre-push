#!/bin/sh
# pre-push: refuse to push any commit that is not signed, or not authored by the
# expected identity.
#
# Required by the TP's cahier des charges, section 5.1 ("commits verifies") and
# the "methode de travail et gouvernance" grading criterion. Only the commits
# actually being pushed are checked, so the pre-existing history authored by the
# trainer (already on origin) is never re-inspected.
set -u

EXPECTED_NAME="WhiteMuush"
EXPECTED_EMAIL="melvin.petit31@gmail.com"
ZERO="0000000000000000000000000000000000000000"

fail=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # Branch deletion (git push --delete): nothing to inspect.
    [ "$local_sha" = "$ZERO" ] && continue

    if [ "$remote_sha" = "$ZERO" ]; then
        # New branch on the remote: exclude everything already pushed, otherwise
        # the whole ancestry (including the trainer's commits) would be checked.
        range=$(git rev-list "$local_sha" --not --remotes=origin)
    else
        range=$(git rev-list "$remote_sha..$local_sha")
    fi

    for sha in $range; do
        short=$(git rev-parse --short "$sha")
        subject=$(git log -1 --format=%s "$sha")
        signature=$(git log -1 --format=%G? "$sha")
        author_name=$(git log -1 --format=%an "$sha")
        author_email=$(git log -1 --format=%ae "$sha")

        # G = good signature, U = good but signer not marked trusted.
        # N = none, B = bad, E = cannot check (missing allowed_signers).
        case "$signature" in
            G | U) ;;
            *)
                echo "  KO $short  signature manquante ou invalide (%G? = $signature)  $subject"
                fail=1
                ;;
        esac

        if [ "$author_name" != "$EXPECTED_NAME" ] || [ "$author_email" != "$EXPECTED_EMAIL" ]; then
            echo "  KO $short  auteur inattendu ($author_name <$author_email>)  $subject"
            fail=1
        fi
    done
done

if [ "$fail" -ne 0 ]; then
    cat <<'EOF'

Push refuse.

Chaque commit pousse doit etre signe et authore par WhiteMuush <melvin.petit31@gmail.com>.

Reparer le dernier commit :
    git commit --amend --no-edit --reset-author

Reparer les N derniers commits :
    git rebase --exec 'git commit --amend --no-edit --reset-author' HEAD~N

Controler avant de repousser :
    git log --format='%h %an <%ae> %G? %s'
EOF
    exit 1
fi

exit 0
